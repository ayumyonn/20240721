<% content_for(:title, 'Ribbon一覧') %>
<div class="container pt-3">
  <div class="row">
    <div class="col-lg-10 offset-lg-1">
      <!-- 検索フォーム -->
      <form>
        <div class="input-group mb-3"><input class="form-control" placeholder="検索ワード" type="search"/>
          <div class="input-group-append"><input type="submit" value="検索" class="btn btn-primary"/></div>
        </div>
      </form>
    </div>
  </div>
  <!-- コレクション一覧 -->
  <div class="row">
    <div class="col-12">
      <div class="row">
      <%# <h1>Ribbon一覧</h1> %>
      <h1>Your Collections</h1>
      <%= link_to 'All Bookmarked Posts', new_collection_path, class: "btn btn-primary", style: "width: 270px; height: 170px;" %>
      <%= link_to 'Create New Collection', new_collection_path, class: "btn btn-primary", style: "width: 270px; height: 170px;" %>
      </div>
    </div>
  </div>
</div>